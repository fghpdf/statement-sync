    replacement_chunks {
      target_content: "import React from \'react\';\nimport { ShieldCheck, HardDrive, Settings, Blocks, Sparkles } from \'lucide-react\';\n\nexport function PlanDocument() {\n  return (\n    <div className=\"bg-white p-6 md:p-8 rounded-2xl shadow-sm border border-gray-100 h-full overflow-y-auto\">\n      <div className=\"flex items-center gap-3 mb-8\">\n        <div className=\"p-3 bg-blue-50 text-blue-600 rounded-xl\">\n          <Sparkles className=\"w-6 h-6\" />\n        </div>\n        <div>\n          <h1 className=\"text-2xl font-bold text-gray-900\">\351\223\266\350\241\214\350\264\246\345\215\225\345\220\214\346\255\245\346\217\222\344\273\266</h1>\n          <p className=\"text-gray-500\">\351\241\271\347\233\256\350\247\204\345\210\222\344\270\216\346\236\266\346\236\204\350\256\276\350\256\241 (Project Plan)</p>\n        </div>\n      </div>\n\n      <div className=\"space-y-8\">\n        {/* Section 1 */}\n        <section>\n          <h2 className=\"text-lg font-bold text-gray-900 mb-4 flex items-center gap-2\">\n            <Blocks className=\"w-5 h-5 text-blue-500\" />\n            \344\270\200\343\200\201\347\263\273\347\273\237\346\236\266\346\236\204 (Architecture)\n          </h2>\n          <div className=\"bg-gray-50 rounded-xl p-5 space-y-4 text-sm text-gray-700\">\n            <p>\346\217\222\344\273\266\345\237\272\344\272\216 <strong>Manifest V3</strong> \346\240\207\345\207\206\345\274\200\345\217\221\357\274\214\344\270\273\350\246\201\345\210\206\344\270\272\344\270\211\344\270\252\346\240\270\345\277\203\346\250\241\345\235\227\357\274\232</p>\n            <ul className=\"list-disc pl-5 space-y-2\">\n              <li><strong>Popup UI (\344\272\244\344\272\222\347\225\214\351\235\242):</strong> \346\217\220\344\276\233\347\224\250\346\210\267\346\211\213\345\212\250\350\247\246\345\217\221\345\257\274\345\207\272\343\200\201\346\237\245\347\234\213\345\220\214\346\255\245\345\216\206\345\217\262\343\200\201\351\205\215\347\275\256\344\272\221\347\233\230\346\216\210\346\235\203\357\274\210\345\246\202 Google Drive\357\274\211\347\232\204\347\225\214\351\235\242\343\200\202</li>\n              <li><strong>Content Scripts (\345\206\205\345\256\271\350\204\232\346\234\254):</strong> \346\214\211\345\237\237\345\220\215\346\263\250\345\205\245\345\210\260\344\270\215\345\220\214\351\223\266\350\241\214\357\274\210\345\246\202 Chase, BoA \347\255\211\357\274\211\347\232\204\350\264\246\345\215\225\351\241\265\343\200\202\350\264\237\350\264\243\350\247\243\346\236\220 DOM \346\217\220\345\217\226\350\264\246\345\215\225\346\230\216\347\273\206\357\274\214\346\210\226\346\213\246\346\210\252\344\270\213\350\275\275\350\257\267\346\261\202\343\200\202</li>\n              <li><strong>Background Service Worker (\345\220\216\345\217\260\346\234\215\345\212\241):</strong> \345\244\204\347\220\206 Google Drive OAuth 2.0 \350\272\253\344\273\275\351\252\214\350\257\201\357\274\214\350\260\203\347\224\250 Drive API \345\210\233\345\273\272\346\234\272\346\236\204\346\226\207\344\273\266\345\244\271\345\271\266\344\270\212\344\274\240 CSV \346\226\207\344\273\266\343\200\202</li>\n            </ul>\n          </div>\n        </section>\n\n        {/* Section 2 */}\n        <section>\n          <h2 className=\"text-lg font-bold text-gray-900 mb-4 flex items-center gap-2\">\n            <HardDrive className=\"w-5 h-5 text-green-500\" />\n            \344\272\214\343\200\201\346\240\270\345\277\203\344\270\232\345\212\241\346\265\201\347\250\213 (Workflow)\n          </h2>\n          <ol className=\"relative border-l border-gray-200 ml-3 space-y-6\">\n            <li className=\"pl-6\">\n              <span className=\"absolute flex items-center justify-center w-6 h-6 bg-blue-100 rounded-full -left-3 ring-4 ring-white text-blue-600 font-bold text-xs\">1</span>\n              <h3 className=\"font-semibold text-gray-900\">\346\225\260\346\215\256\350\216\267\345\217\226 (Data Extraction)</h3>\n              <p className=\"text-sm text-gray-600 mt-1\">\344\275\277\347\224\250\347\255\226\347\225\245\346\250\241\345\274\217 (Strategy Pattern)\357\274\214\346\240\271\346\215\256\345\275\223\345\211\215 URL \345\214\271\351\205\215\345\257\271\345\272\224\347\232\204\350\247\243\346\236\220\345\231\250\343\200\202\347\233\264\346\216\245\350\247\246\345\217\221\345\256\230\346\226\271 CSV \344\270\213\350\275\275\346\213\246\346\210\252\357\274\214\346\210\226\345\260\206\351\241\265\351\235\242\350\241\250\346\240\274\346\225\260\346\215\256\350\275\254\344\270\272 CSV Blob\343\200\202</p>\n            </li>\n            <li className=\"pl-6\">\n              <span className=\"absolute flex items-center justify-center w-6 h-6 bg-blue-100 rounded-full -left-3 ring-4 ring-white text-blue-600 font-bold text-xs\">2</span>\n              <h3 className=\"font-semibold text-gray-900\">\346\226\207\344\273\266\351\207\215\345\221\275\345\220\215 (Formatting)</h3>\n              <p className=\"text-sm text-gray-600 mt-1\">\346\240\271\346\215\256\347\253\231\347\202\271\344\270\212\344\270\213\346\226\207\346\217\220\345\217\226\345\205\203\346\225\260\346\215\256\357\274\214\346\214\211 <code>[\346\234\272\346\236\204\345\220\215]_[\350\264\246\346\210\267\345\260\276\345\217\267]_[\345\271\264\346\234\210].csv</code> \347\232\204\346\240\207\345\207\206\345\214\226\346\240\274\345\274\217\345\234\250\345\206\205\345\255\230\344\270\255\351\207\215\345\221\275\345\220\215\346\226\207\344\273\266\343\200\202</p>\n            </li>\n            <li className=\"pl-6\">\n              <span className=\"absolute flex items-center justify-center w-6 h-6 bg-blue-100 rounded-full -left-3 ring-4 ring-white text-blue-600 font-bold text-xs\">3</span>\n              <h3 className=\"font-semibold text-gray-900\">\344\272\221\347\253\257\345\275\222\346\241\243 (Cloud Sync)</h3>\n              <p className=\"text-sm text-gray-600 mt-1\">\350\260\203\347\224\250 Google Drive API\357\274\232\345\205\210\346\243\200\346\237\245\346\240\271\347\233\256\345\275\225\344\270\213\346\230\257\345\220\246\345\255\230\345\234\250\345\220\214\345\220\215\346\234\272\346\236\204\346\226\207\344\273\266\345\244\271\357\274\214\344\270\215\345\255\230\345\234\250\345\210\231\345\210\233\345\273\272\343\200\202\346\234\200\345\220\216\345\260\206 CSV \344\270\212\344\274\240\350\207\263\350\257\245\346\226\207\344\273\266\345\244\271\345\206\205\345\271\266\350\256\260\345\275\225\345\220\214\346\255\245\347\212\266\346\200\201\343\200\202</p>\n            </li>\n          </ol>\n        </section>\n\n        {/* Section 3 */}\n        <section>\n          <h2 className=\"text-lg font-bold text-gray-900 mb-4 flex items-center gap-2\">\n            <ShieldCheck className=\"w-5 h-5 text-purple-500\" />\n            \344\270\211\343\200\201\346\212\200\346\234\257\351\200\211\345\236\213\344\270\216\351\232\276\347\202\271 (Tech Stack)\n          </h2>\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n            <div className=\"border border-gray-100 bg-white p-4 rounded-xl shadow-sm\">\n              <h4 className=\"font-semibold text-gray-900 text-sm mb-2\">\346\212\200\346\234\257\346\240\210\346\216\250\350\215\220</h4>\n              <ul className=\"text-sm text-gray-600 space-y-1\">\n                <li>- React 18 + Tailwind CSS (\346\236\204\345\273\272 UI)</li>\n                <li>- Vite + CRXJS Vite Plugin (\346\211\223\345\214\205\346\217\222\344\273\266)</li>\n                <li>- <code>chrome.identity</code> (\350\216\267\345\217\226 OAuth Token)</li>\n                <li>- Google Drive REST API v3</li>\n              </ul>\n            </div>\n            <div className=\"border border-gray-100 bg-white p-4 rounded-xl shadow-sm\">\n              <h4 className=\"font-semibold text-gray-900 text-sm mb-2\">\346\275\234\345\234\250\351\232\276\347\202\271</h4>\n              <ul className=\"text-sm text-gray-600 space-y-1\">\n                <li>- <strong>DOM \350\204\206\345\274\261\346\200\247:</strong> \351\223\266\350\241\214\347\275\221\347\253\231\345\211\215\347\253\257\346\224\271\347\211\210\344\274\232\345\257\274\350\207\264\346\217\220\345\217\226\345\244\261\346\225\210\357\274\214\351\234\200\351\205\215\347\275\256\345\214\226\347\232\204\350\247\243\346\236\220\350\247\204\345\210\231\343\200\202</li>\n                <li>- <strong>CSP/CORS \351\231\220\345\210\266:</strong> \350\267\250\345\237\237\344\270\212\344\274\240\351\234\200\345\234\250 <code>manifest.json</code> \345\243\260\346\230\216 host permissions\343\200\202</li>\n              </ul>\n            </div>\n          </div>\n        </section>\n      </div>\n    </div>\n  );\n}\n"
      replacement_content: "import React from \'react\';\n\nexport function PlanDocument() {\n  return (\n    <div className=\"bg-white p-8 md:p-12 h-full overflow-y-auto border border-gray-200 font-sans\">\n      <div className=\"mb-12 border-b border-black pb-6\">\n        <h1 className=\"text-2xl font-medium text-black tracking-wide mb-2\">\351\223\266\350\241\214\350\264\246\345\215\225\345\220\214\346\255\245\346\217\222\344\273\266</h1>\n        <p className=\"text-sm text-gray-500 uppercase tracking-widest\">\351\241\271\347\233\256\350\247\204\345\210\222\344\270\216\346\236\266\346\236\204\350\256\276\350\256\241</p>\n      </div>\n\n      <div className=\"space-y-12\">\n        {/* Section 1 */}\n        <section>\n          <h2 className=\"text-sm font-medium text-black mb-6 uppercase tracking-widest flex items-center gap-2\">\n            \344\270\200\343\200\201\347\263\273\347\273\237\346\236\266\346\236\204\n          </h2>\n          <div className=\"space-y-4 text-sm text-gray-600 font-light leading-relaxed\">\n            <p>\345\237\272\344\272\216 <strong>Manifest V3</strong> \346\240\207\345\207\206\345\274\200\345\217\221\357\274\214\345\210\206\344\270\272\344\270\211\344\270\252\346\240\270\345\277\203\346\250\241\345\235\227\357\274\232</p>\n            <ul className=\"space-y-4 mt-4\">\n              <li className=\"flex gap-4\">\n                <span className=\"text-black text-xs font-mono mt-0.5\">01</span>\n                <div>\n                  <strong className=\"text-black block mb-1 font-medium\">Popup UI (\344\272\244\344\272\222\347\225\214\351\235\242)</strong>\n                  \346\217\220\344\276\233\347\224\250\346\210\267\346\211\213\345\212\250\350\247\246\345\217\221\345\257\274\345\207\272\343\200\201\346\237\245\347\234\213\345\220\214\346\255\245\345\216\206\345\217\262\343\200\201\351\205\215\347\275\256\344\272\221\347\233\230\346\216\210\346\235\203\347\232\204\346\236\201\347\256\200\347\225\214\351\235\242\343\200\202\n                </div>\n              </li>\n              <li className=\"flex gap-4\">\n                <span className=\"text-black text-xs font-mono mt-0.5\">02</span>\n                <div>\n                  <strong className=\"text-black block mb-1 font-medium\">Content Scripts (\345\206\205\345\256\271\350\204\232\346\234\254)</strong>\n                  \346\214\211\345\237\237\345\220\215\346\263\250\345\205\245\350\264\246\345\215\225\351\241\265\343\200\202\350\264\237\350\264\243\350\247\243\346\236\220 DOM \346\217\220\345\217\226\350\264\246\345\215\225\346\230\216\347\273\206\357\274\214\346\210\226\346\213\246\346\210\252\344\270\213\350\275\275\350\257\267\346\261\202\343\200\202\n                </div>\n              </li>\n              <li className=\"flex gap-4\">\n                <span className=\"text-black text-xs font-mono mt-0.5\">03</span>\n                <div>\n                  <strong className=\"text-black block mb-1 font-medium\">Background Service Worker</strong>\n                  \345\244\204\347\220\206 Google Drive OAuth 2.0 \351\252\214\350\257\201\357\274\214\350\260\203\347\224\250 Drive API \345\210\233\345\273\272\346\234\272\346\236\204\346\226\207\344\273\266\345\244\271\345\271\266\344\270\212\344\274\240 CSV\343\200\202\n                </div>\n              </li>\n            </ul>\n          </div>\n        </section>\n\n        <div className=\"w-full h-px bg-gray-100\"></div>\n\n        {/* Section 2 */}\n        <section>\n          <h2 className=\"text-sm font-medium text-black mb-6 uppercase tracking-widest\">\n            \344\272\214\343\200\201\346\240\270\345\277\203\344\270\232\345\212\241\346\265\201\347\250\213\n          </h2>\n          <div className=\"space-y-8\">\n            <div className=\"border-l-2 border-black pl-5\">\n              <h3 className=\"text-sm font-medium text-black mb-2\">1. \346\225\260\346\215\256\350\216\267\345\217\226 (Extraction)</h3>\n              <p className=\"text-sm text-gray-500 font-light leading-relaxed\">\344\275\277\347\224\250\347\255\226\347\225\245\346\250\241\345\274\217\357\274\214\346\240\271\346\215\256\345\275\223\345\211\215 URL \345\214\271\351\205\215\345\257\271\345\272\224\347\232\204\350\247\243\346\236\220\345\231\250\343\200\202\346\213\246\346\210\252\345\256\230\346\226\271 CSV \344\270\213\350\275\275\357\274\214\346\210\226\345\260\206\351\241\265\351\235\242\350\241\250\346\240\274\350\275\254\346\215\242\344\270\272 CSV\343\200\202</p>\n            </div>\n            <div className=\"border-l-2 border-black pl-5\">\n              <h3 className=\"text-sm font-medium text-black mb-2\">2. \346\226\207\344\273\266\351\207\215\345\221\275\345\220\215 (Formatting)</h3>\n              <p className=\"text-sm text-gray-500 font-light leading-relaxed\">\346\240\271\346\215\256\347\253\231\347\202\271\344\270\212\344\270\213\346\226\207\346\217\220\345\217\226\345\205\203\346\225\260\346\215\256\357\274\214\346\214\211 [\346\234\272\346\236\204\345\220\215]_[\350\264\246\346\210\267\345\260\276\345\217\267]_[\345\271\264\346\234\210].csv \347\232\204\346\240\207\345\207\206\345\214\226\346\240\274\345\274\217\351\207\215\345\221\275\345\220\215\343\200\202</p>\n            </div>\n            <div className=\"border-l-2 border-black pl-5\">\n              <h3 className=\"text-sm font-medium text-black mb-2\">3. \344\272\221\347\253\257\345\275\222\346\241\243 (Cloud Sync)</h3>\n              <p className=\"text-sm text-gray-500 font-light leading-relaxed\">\350\260\203\347\224\250 Drive API\357\274\232\346\243\200\346\237\245\346\240\271\347\233\256\345\275\225\346\230\257\345\220\246\345\255\230\345\234\250\346\234\272\346\236\204\346\226\207\344\273\266\345\244\271\357\274\214\344\270\215\345\255\230\345\234\250\345\210\231\345\210\233\345\273\272\343\200\202\344\270\212\344\274\240\346\226\207\344\273\266\345\271\266\350\256\260\345\275\225\345\220\214\346\255\245\347\212\266\346\200\201\343\200\202</p>\n            </div>\n          </div>\n        </section>\n\n        <div className=\"w-full h-px bg-gray-100\"></div>\n\n        {/* Section 3 */}\n        <section>\n          <h2 className=\"text-sm font-medium text-black mb-6 uppercase tracking-widest\">\n            \344\270\211\343\200\201\346\212\200\346\234\257\351\200\211\345\236\213\344\270\216\351\232\276\347\202\271\n          </h2>\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-8\">\n            <div>\n              <h4 className=\"font-medium text-black text-sm mb-4\">\346\212\200\346\234\257\346\240\210</h4>\n              <ul className=\"text-sm text-gray-500 font-light space-y-2\">\n                <li>React 18 + Tailwind CSS</li>\n                <li>Vite + CRXJS Vite Plugin</li>\n                <li>chrome.identity OAuth</li>\n                <li>Google Drive API v3</li>\n              </ul>\n            </div>\n            <div>\n              <h4 className=\"font-medium text-black text-sm mb-4\">\346\275\234\345\234\250\351\232\276\347\202\271</h4>\n              <ul className=\"text-sm text-gray-500 font-light space-y-4\">\n                <li>\n                  <strong className=\"text-black block text-xs mb-1 font-medium\">DOM \350\204\206\345\274\261\346\200\247</strong>\n                  \351\223\266\350\241\214\347\275\221\347\253\231\345\211\215\347\253\257\346\224\271\347\211\210\344\274\232\345\257\274\350\207\264\346\217\220\345\217\226\345\244\261\346\225\210\357\274\214\351\234\200\351\205\215\347\275\256\345\214\226\350\247\243\346\236\220\350\247\204\345\210\231\343\200\202\n                </li>\n                <li>\n                  <strong className=\"text-black block text-xs mb-1 font-medium\">CSP/CORS \351\231\220\345\210\266</strong>\n                  \350\267\250\345\237\237\344\270\212\344\274\240\351\234\200\345\234\250 manifest.json \345\243\260\346\230\216 host permissions\343\200\202\n                </li>\n              </ul>\n            </div