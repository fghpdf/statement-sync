    replacement_infos {
      original_chunk {
        target_content: "import React, { useState } from \'react\';\nimport { CheckCircle2, Cloud, Settings, DownloadCloud, FileText, ChevronRight, Loader2, Building } from \'lucide-react\';\n\nexport function ExtensionPopupMockup() {\n  const [isSyncing, setIsSyncing] = useState(false);\n  const [synced, setSynced] = useState(false);\n\n  const handleSync = () => {\n    setIsSyncing(true);\n    // Simulate sync process\n    setTimeout(() => {\n      setIsSyncing(false);\n      setSynced(true);\n      setTimeout(() => setSynced(false), 3000);\n    }, 1500);\n  };\n\n  return (\n    <div className=\"w-[320px] h-[480px] bg-white rounded-2xl shadow-2xl border border-gray-200 overflow-hidden flex flex-col font-sans\">\n      {/* Header */}\n      <div className=\"bg-blue-600 p-4 text-white flex justify-between items-center\">\n        <div className=\"flex items-center gap-2\">\n          <Cloud className=\"w-5 h-5\" />\n          <span className=\"font-semibold\">StatementSync</span>\n        </div>\n        <Settings className=\"w-4 h-4 opacity-80 hover:opacity-100 cursor-pointer\" />\n      </div>\n\n      {/* Account Status */}\n      <div className=\"bg-blue-50 px-4 py-2 border-b border-blue-100 flex items-center justify-between text-xs\">\n        <div className=\"flex items-center gap-1.5 text-blue-700\">\n          <CheckCircle2 className=\"w-3.5 h-3.5\" />\n          <span className=\"truncate max-w-[150px]\">quxiangxuanqxx@gmail.com</span>\n        </div>\n        <span className=\"text-blue-500 font-medium whitespace-nowrap\">Drive \345\267\262\350\277\236\346\216\245</span>\n      </div>\n\n      {/* Main Content */}\n      <div className=\"flex-1 p-4 flex flex-col\">\n        <div className=\"bg-gray-50 border border-gray-100 rounded-xl p-4 mb-4 text-center\">\n          <Building className=\"w-8 h-8 text-gray-400 mx-auto mb-2\" />\n          <h3 className=\"text-sm font-semibold text-gray-800\">\345\267\262\346\243\200\346\265\213\345\210\260\346\224\257\346\214\201\347\232\204\350\264\246\345\215\225</h3>\n          <p className=\"text-xs text-gray-500 mt-1\">Chase Bank \342\200\242 Credit Card</p>\n        </div>\n\n        <button\n          onClick={handleSync}\n          disabled={isSyncing || synced}\n          className={`w-full py-3 rounded-xl font-medium flex items-center justify-center gap-2 transition-all ${\n            synced\n              ? \'bg-green-500 text-white\'\n              : \'bg-blue-600 hover:bg-blue-700 text-white shadow-md shadow-blue-200\'\n          } disabled:opacity-80`}\n        >\n          {isSyncing ? (\n            <>\n              <Loader2 className=\"w-5 h-5 animate-spin\" />\n              \346\217\220\345\217\226\345\271\266\344\270\212\344\274\240\344\270\255...\n            </>\n          ) : synced ? (\n            <>\n              <CheckCircle2 className=\"w-5 h-5\" />\n              \345\267\262\344\277\235\345\255\230\350\207\263 Drive\n            </>\n          ) : (\n            <>\n              <DownloadCloud className=\"w-5 h-5\" />\n              \345\257\274\345\207\272\345\271\266\345\275\222\346\241\243\350\207\263\344\272\221\347\233\230\n            </>\n          )}\n        </button>\n\n        {/* Recent Files */}\n        <div className=\"mt-6 flex-1 overflow-y-auto\">\n          <h4 className=\"text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3\">\346\234\200\350\277\221\345\275\222\346\241\243</h4>\n          <div className=\"space-y-2\">\n            {[\n              { name: \'Chase_2023-10.csv\', folder: \'Chase\', time: \'\345\210\232\345\210\232\' },\n              { name: \'Amex_2023-09.csv\', folder: \'American Express\', time: \'2\345\244\251\345\211\215\' },\n              { name: \'BoA_2023-09.csv\', folder: \'Bank of America\', time: \'\344\270\212\345\221\250\' },\n            ].map((item, i) => (\n              <div key={i} className=\"flex items-center gap-3 p-2 hover:bg-gray-50 rounded-lg cursor-pointer transition-colors group\">\n                <FileText className=\"w-8 h-8 text-blue-500 p-1.5 bg-blue-50 rounded-lg flex-shrink-0\" />\n                <div className=\"flex-1 min-w-0\">\n                  <p className=\"text-sm font-medium text-gray-800 truncate\">{item.name}</p>\n                  <p className=\"text-xs text-gray-500 truncate\">Drive / {item.folder}</p>\n                </div>\n                <ChevronRight className=\"w-4 h-4 text-gray-300 group-hover:text-gray-500 flex-shrink-0\" />\n              </div>\n            ))}\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n}\n"
        replacement_content: "import React, { useState } from \'react\';\nimport { Check, Settings, Download, FileText, Loader2 } from \'lucide-react\';\n\nexport function ExtensionPopupMockup() {\n  const [isSyncing, setIsSyncing] = useState(false);\n  const [synced, setSynced] = useState(false);\n\n  const handleSync = () => {\n    setIsSyncing(true);\n    // Simulate sync process\n    setTimeout(() => {\n      setIsSyncing(false);\n      setSynced(true);\n      setTimeout(() => setSynced(false), 3000);\n    }, 1500);\n  };\n\n  return (\n    <div className=\"w-[320px] h-[480px] bg-white border border-gray-200 flex flex-col font-sans text-gray-900 shadow-sm relative mx-auto\">\n      {/* Header */}\n      <div className=\"px-6 pt-6 pb-4 flex justify-between items-center\">\n        <span className=\"text-sm font-medium tracking-wide\">Sync.</span>\n        <Settings className=\"w-4 h-4 text-gray-400 hover:text-black cursor-pointer transition-colors\" strokeWidth={1.5} />\n      </div>\n\n      {/* Account Status - Minimal */}\n      <div className=\"px-6 pb-6\">\n         <div className=\"text-[10px] text-gray-400 uppercase tracking-widest mb-1\">Drive \350\264\246\345\217\267</div>\n         <div className=\"flex items-center gap-2 text-xs\">\n           <div className=\"w-1.5 h-1.5 rounded-full bg-black\"></div>\n           <span className=\"truncate text-gray-600\">quxiangxuanqxx@gmail.com</span>\n         </div>\n      </div>\n\n      <div className=\"w-full h-px bg-gray-100\"></div>\n\n      {/* Main Content */}\n      <div className=\"flex-1 p-6 flex flex-col\">\n        {/* Status Card (Minimalist left border style) */}\n        <div className=\"border-l-2 border-black pl-4 py-1 mb-8\">\n          <h3 className=\"text-sm font-medium text-black\">\345\267\262\346\243\200\346\265\213\345\210\260\350\264\246\345\215\225</h3>\n          <p className=\"text-xs text-gray-500 mt-1\">Chase Bank \342\200\242 Credit Card</p>\n        </div>\n\n        <button\n          onClick={handleSync}\n          disabled={isSyncing || synced}\n          className={`w-full py-2.5 text-sm transition-all flex items-center justify-center gap-2 border ${\n            synced\n              ? \'border-gray-200 text-gray-400 bg-transparent cursor-default\'\n              : \'bg-black text-white border-black hover:bg-gray-800\'\n          } disabled:opacity-50`}\n        >\n          {isSyncing ? (\n            <>\n              <Loader2 className=\"w-4 h-4 animate-spin\" strokeWidth={1.5} />\n              \346\217\220\345\217\226\345\271\266\344\270\212\344\274\240\344\270\255...\n            </>\n          ) : synced ? (\n            <>\n              <Check className=\"w-4 h-4\" strokeWidth={1.5} />\n              \345\267\262\344\277\235\345\255\230\350\207\263 Drive\n            </>\n          ) : (\n            <>\n              <Download className=\"w-4 h-4\" strokeWidth={1.5} />\n              \345\257\274\345\207\272\345\271\266\345\275\222\346\241\243\n            </>\n          )}\n        </button>\n\n        {/* Recent Files */}\n        <div className=\"mt-10 flex-1\">\n          <h4 className=\"text-[10px] text-gray-400 uppercase tracking-widest mb-4\">\346\234\200\350\277\221\345\275\222\346\241\243</h4>\n          <div className=\"space-y-4\">\n            {[\n              { name: \'Chase_2023-10.csv\', folder: \'Chase\' },\n              { name: \'Amex_2023-09.csv\', folder: \'American Express\' },\n              { name: \'BoA_2023-09.csv\', folder: \'Bank of America\' },\n            ].map((item, i) => (\n              <div key={i} className=\"flex items-center gap-3 cursor-pointer group\">\n                <FileText className=\"w-4 h-4 text-gray-300 group-hover:text-black transition-colors\" strokeWidth={1.5} />\n                <div className=\"flex-1 min-w-0 flex flex-col gap-0.5\">\n                  <p className=\"text-xs font-medium text-gray-700 truncate group-hover:text-black transition-colors\">{item.name}</p>\n                  <p className=\"text-[10px] text-gray-400 truncate\">{item.folder}</p>\n                </div>\n              </div>\n            ))}\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n}\n"
      }
