      original_chunk {
        target_content: "  return (\n    <div className=\"w-[320px] h-[480px] bg-white border border-gray-200 flex flex-col font-sans text-gray-900 shadow-sm relative mx-auto\">\n      {/* Header */}\n      <div className=\"px-6 pt-6 pb-4 flex justify-between items-center\">\n        <span className=\"text-sm font-medium tracking-wide\">Sync.</span>\n        <Settings className=\"w-4 h-4 text-gray-400 hover:text-black cursor-pointer transition-colors\" strokeWidth={1.5} />\n      </div>\n\n      {/* Account Status - Minimal */}\n      <div className=\"px-6 pb-6\">\n         <div className=\"text-[10px] text-gray-400 uppercase tracking-widest mb-2\">Drive \350\264\246\345\217\267</div>\n         <div className=\"flex items-center justify-between\">\n           <div className=\"flex items-center gap-2 text-xs\">\n             <div className={`w-1.5 h-1.5 rounded-full ${isAuthenticated ? \'bg-green-500\' : \'bg-gray-300\'}`}></div>\n             <span className=\"truncate text-gray-600\">{isAuthenticated ? \'\345\267\262\350\277\236\346\216\245 Google Drive\' : \'\346\234\252\350\277\236\346\216\245 Drive\'}</span>\n           </div>\n           {!isAuthenticated && (\n             <button \n               onClick={handleLogin} \n               disabled={isAuthenticating}\n               className=\"text-[10px] bg-black text-white px-3 py-1.5 rounded disabled:opacity-50 transition-opacity\"\n             >\n               {isAuthenticating ? \'\350\277\236\346\216\245\344\270\255...\' : \'\350\277\236\346\216\245\'}\n             </button>\n           )}\n         </div>\n      </div>\n\n      <div className=\"w-full h-px bg-gray-100\"></div>\n\n      {/* Main Content */}\n      <div className=\"flex-1 p-6 flex flex-col\">\n        {/* Status Card (Minimalist left border style) */}\n        <div className=\"border-l-2 border-black pl-4 py-1 mb-6\">\n          <h3 className=\"text-sm font-medium text-black\">\345\267\262\346\243\200\346\265\213\345\210\260\350\264\246\345\215\225</h3>\n          <p className=\"text-xs text-gray-500 mt-1\">American Express JP \342\200\242 Credit Card</p>\n        </div>\n\n        {error && (\n          <div className=\"mb-6 p-3 bg-red-50 border border-red-100 rounded flex items-start gap-2 text-red-600\">\n            <AlertCircle className=\"w-4 h-4 flex-shrink-0 mt-0.5\" strokeWidth={1.5} />\n            <span className=\"text-xs leading-relaxed\">{error}</span>\n          </div>\n        )}\n\n        <button\n          onClick={handleSync}\n          disabled={isSyncing || synced || !isAuthenticated}\n          className={`w-full py-2.5 text-sm transition-all flex items-center justify-center gap-2 border ${\n            synced\n              ? \'border-gray-200 text-gray-400 bg-transparent cursor-default\'\n              : !isAuthenticated\n              ? \'border-gray-200 text-gray-400 bg-gray-50 cursor-not-allowed\'\n              : \'bg-black text-white border-black hover:bg-gray-800\'\n          } disabled:opacity-50`}\n        >\n          {isSyncing ? (\n            <>\n              <Loader2 className=\"w-4 h-4 animate-spin\" strokeWidth={1.5} />\n              \346\217\220\345\217\226\345\271\266\344\270\212\344\274\240\344\270\255...\n            </>\n          ) : synced ? (\n            <>\n              <Check className=\"w-4 h-4\" strokeWidth={1.5} />\n              \345\267\262\344\277\235\345\255\230\350\207\263 Drive\n            </>\n          ) : (\n            <>\n              <Download className=\"w-4 h-4\" strokeWidth={1.5} />\n              \345\257\274\345\207\272\345\271\266\345\275\222\346\241\243\n            </>\n          )}\n        </button>\n\n        {/* Recent Files */}\n        <div className=\"mt-10 flex-1\">\n          <h4 className=\"text-[10px] text-gray-400 uppercase tracking-widest mb-4\">\346\234\200\350\277\221\345\275\222\346\241\243</h4>\n          <div className=\"space-y-4\">\n            {[\n              { name: \'AmexJP_1234_2023-10_Statement.csv\', folder: \'Amex JP\' },\n              { name: \'AmexJP_1234_2023-09_Statement.csv\', folder: \'Amex JP\' },\n              { name: \'Chase_5678_2023-09_Statement.csv\', folder: \'Chase\' },\n            ].map((item, i) => (\n              <div key={i} className=\"flex items-center gap-3 cursor-pointer group\">\n                <FileText className=\"w-4 h-4 text-gray-300 group-hover:text-black transition-colors\" strokeWidth={1.5} />\n                <div className=\"flex-1 min-w-0 flex flex-col gap-0.5\">\n                  <p className=\"text-xs font-medium text-gray-700 truncate group-hover:text-black transition-colors\">{item.name}</p>\n                  <p className=\"text-[10px] text-gray-400 truncate\">{item.folder}</p>\n                </div>\n              </div>\n            ))}\n          </div>\n        </div>\n      </div>\n    </div>\n  );"
        replacement_content: "  return (\n    <div className=\"w-[320px] h-[480px] bg-white border border-gray-200 flex flex-col font-sans text-gray-900 shadow-sm relative mx-auto\">\n      {/* Header */}\n      <div className=\"px-6 pt-6 pb-4 flex justify-between items-center\">\n        <span className=\"text-sm font-medium tracking-wide\">\n          {showSettings ? \'Settings.\' : \'Sync.\'}\n        </span>\n        <button \n          onClick={() => setShowSettings(!showSettings)}\n          className=\"text-gray-400 hover:text-black transition-colors\"\n        >\n          {showSettings ? (\n            <span className=\"text-xs uppercase tracking-widest font-medium\">Done</span>\n          ) : (\n            <Settings className=\"w-4 h-4\" strokeWidth={1.5} />\n          )}\n        </button>\n      </div>\n\n      {showSettings ? (\n        <div className=\"flex-1 px-6 pb-6 flex flex-col\">\n          <div className=\"w-full h-px bg-gray-100 mb-6\"></div>\n          \n          <div className=\"mb-8\">\n            <h4 className=\"text-[10px] text-gray-400 uppercase tracking-widest mb-4\">\345\221\275\345\220\215\347\272\246\345\256\232 (Naming Convention)</h4>\n            <label className=\"flex items-center justify-between cursor-pointer group\">\n              <span className=\"text-xs text-gray-700 group-hover:text-black transition-colors\">\345\214\205\345\220\253 \"_Statement\" \345\220\216\347\274\200</span>\n              <div className=\"relative\">\n                <input \n                  type=\"checkbox\" \n                  className=\"sr-only\" \n                  checked={includeSuffix}\n                  onChange={(e) => setIncludeSuffix(e.target.checked)}\n                />\n                <div className={`block w-8 h-4 rounded-full transition-colors ${includeSuffix ? \'bg-black\' : \'bg-gray-200\'}`}></div>\n                <div className={`absolute left-0.5 top-0.5 bg-white w-3 h-3 rounded-full transition-transform ${includeSuffix ? \'translate-x-4\' : \'translate-x-0\'}`}></div>\n              </div>\n            </label>\n            <p className=\"text-[10px] text-gray-400 mt-2\">\n              \347\244\272\344\276\213: AmexJP_XXXX_2023-10{includeSuffix ? \'_Statement\' : \'\'}.csv\n            </p>\n          </div>\n\n          <div className=\"mb-8\">\n            <h4 className=\"text-[10px] text-gray-400 uppercase tracking-widest mb-4\">\350\264\246\346\210\267 (Account)</h4>\n            <div className=\"flex items-center justify-between\">\n               <div className=\"flex items-center gap-2 text-xs\">\n                 <div className={`w-1.5 h-1.5 rounded-full ${isAuthenticated ? \'bg-green-500\' : \'bg-gray-300\'}`}></div>\n                 <span className=\"truncate text-gray-600\">{isAuthenticated ? \'\345\267\262\350\277\236\346\216\245 Drive\' : \'\346\234\252\350\277\236\346\216\245 Drive\'}</span>\n               </div>\n               {isAuthenticated && (\n                 <button \n                   onClick={handleLogout}\n                   className=\"text-[10px] text-red-500 hover:text-red-600 transition-colors uppercase tracking-widest\"\n                 >\n                   \346\226\255\345\274\200\350\277\236\346\216\245 (Disconnect)\n                 </button>\n               )}\n            </div>\n          </div>\n        </div>\n      ) : (\n        <>\n          {/* Account Status - Minimal */}\n          <div className=\"px-6 pb-6\">\n             <div className=\"text-[10px] text-gray-400 uppercase tracking-widest mb-2\">Drive \350\264\246\345\217\267</div>\n             <div className=\"flex items-center justify-between\">\n               <div className=\"flex items-center gap-2 text-xs\">\n                 <div className={`w-1.5 h-1.5 rounded-full ${isAuthenticated ? \'bg-green-500\' : \'bg-gray-300\'}`}></div>\n                 <span className=\"truncate text-gray-600\">{isAuthenticated ? \'\345\267\262\350\277\236\346\216\245 Google Drive\' : \'\346\234\252\350\277\236\346\216\245 Drive\'}</span>\n               </div>\n               {!isAuthenticated && (\n                 <button \n                   onClick={handleLogin} \n                   disabled={isAuthenticating}\n                   className=\"text-[10px] bg-black text-white px-3 py-1.5 rounded disabled:opacity-50 transition-opacity\"\n                 >\n                   {isAuthenticating ? \'\350\277\236\346\216\245\344\270\255...\' : \'\350\277\236\346\216\245\'}\n                 </button>\n               )}\n             </div>\n          </div>\n\n          <div className=\"w-full h-px bg-gray-100\"></div>\n\n          {/* Main Content */}\n          <div className=\"flex-1 p-6 flex flex-col\">\n            {/* Status Card (Minimalist left border style) */}\n            <div className=\"border-l-2 border-black pl-4 py-1 mb-6\">\n              <h3 className=\"text-sm font-medium text-black\">\345\267\262\346\243\200\346\265\213\345\210\260\350\264\246\345\215\225</h3>\n              <p className=\"text-xs text-gray-500 mt-1\">American Express JP \342\200\242 Credit Card</p>\n            </div>\n\n            {error && (\n              <div className=\"mb-6 p-3 bg-red-50 border border-red-100 rounded flex items-start gap-2 text-red-600\">\n                <AlertCircle className=\"w-4 h-4 flex-shrink-0 mt-0.5\" strokeWidth={1.5} />\n                <span className=\"text-xs leading-relaxed\">{error}</span>\n              </div>\n            )}\n\n            <button\n              onClick={handleSync}\n              disabled={isSyncing || synced || !isAuthenticated}\n              className={`w-full py-2.5 text-sm transition-all flex items-center justify-center gap-2 border ${\n                synced\n                  ? \'border-gray-200 text-gray-400 bg-transparent cursor-default\'\n                  : !isAuthenticated\n                  ? \'border-gray-200 text-gray-400 bg-gray-50 cursor-not-allowed\'\n                  : \'bg-black text-white border-black hover:bg-gray-800\'\n              } disabled:opacity-50`}\n            >\n              {isSyncing ? (\n                <>\n                  <Loader2 className=\"w-4 h-4 animate-spin\" strokeWidth={1.5} />\n                  \346\217\220\345\217\226\345\271\266\344\270\212\344\274\240\344\270\255...\n                </>\n              ) : synced ? (\n                <>\n                  <Check className=\"w-4 h-4\" strokeWidth={1.5} />\n                  \345\267\262\344\277\235\345\255\230\350\207\263 Drive\n                </>\n              ) : (\n                <>\n                  <Download className=\"w-4 h-4\" strokeWidth={1.5} />\n                  \345\257\274\345\207\272\345\271\266\345\275\222\346\241\243\n                </>\n              )}\n            </button>\n\n            {/* Recent Files */}\n            <div className=\"mt-10 flex-1\">\n              <h4 className=\"text-[10px] text-gray-400 uppercase tracking-widest mb-4\">\346\234\200\350\277\221\345\275\222\346\241\243</h4>\n              <div className=\"space-y-4\">\n                {[\n                  { name: `AmexJP_1234_2023-10${includeSuffix ? \'_Statement\' : \'\'}.csv`, folder: \'Amex JP\' },\n                  { name: `AmexJP_1234_2023-09${includeSuffix ? \'_Statement\' : \'\'}.csv`, folder: \'Amex JP\' },\n                  { name: `Chase_5678_2023-09${includeSuffix ? \'_Statement\' : \'\'}.csv`, folder: \'Chase\' },\n                ].map((item, i) => (\n                  <div key={i} className=\"flex items-center gap-3 cursor-pointer group\">\n                    <FileText className=\"w-4 h-4 text-gray-300 group-hover:text-black transition-colors\" strokeWidth={1.5} />\n                    <div className=\"flex-1 min-w-0 flex flex-col gap-0.5\">\n                      <p className=\"text-xs font-medium text-gray-700 truncate group-hover:text-black transition-colors\">{item.name}</p>\n                      <p className=\"text-[10px] text-gray-400 truncate\">{item.folder}</p>\n                    </div>\n                  </div>\n                ))}\n              </div>\n            </div>\n          </div>\n        </>\n      )}\n    </div>\n  );"
      }
      num_matches: 1
    }
  }
}
