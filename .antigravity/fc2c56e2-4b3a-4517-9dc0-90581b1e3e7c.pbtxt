  planner_response {
    modified_response: "\346\210\221\345\267\262\347\273\217\344\270\272\344\275\240\350\256\276\350\256\241\344\272\206 **\351\223\266\350\241\214\350\264\246\345\215\225\350\207\252\345\212\250\345\257\274\345\207\272\345\212\251\346\211\213** \347\232\204\345\274\200\345\217\221\350\247\204\345\210\222\357\274\214\345\271\266\345\234\250\345\267\245\344\275\234\345\214\272\346\236\204\345\273\272\344\272\206\344\270\200\344\270\252\345\217\257\350\247\206\345\214\226\351\241\271\347\233\256\350\256\241\345\210\222\351\235\242\346\235\277\357\274\214\344\273\245\345\217\212\346\217\222\344\273\266 `Popup UI` \347\232\204\344\272\244\344\272\222\351\242\204\350\247\210\343\200\202\n\n### \360\237\223\214 \345\256\236\346\226\275\350\256\241\345\210\222\346\246\202\350\247\210\n\n\344\270\200\344\270\252\345\256\214\346\225\264\347\232\204\346\265\217\350\247\210\345\231\250\346\217\222\344\273\266\357\274\210\345\237\272\344\272\216 Manifest V3\357\274\211\351\200\232\345\270\270\345\214\205\345\220\253\344\273\245\344\270\213\346\240\270\345\277\203\347\273\223\346\236\204\357\274\214\350\257\267\345\234\250\345\217\263\344\276\247\351\235\242\346\235\277\346\237\245\347\234\213\345\256\214\346\225\264\347\232\204\346\212\200\346\234\257\350\247\204\345\210\222\346\226\207\346\241\243\357\274\232\n- **Popup UI (\345\217\257\350\247\206\345\214\226\344\272\244\344\272\222):** \346\217\222\344\273\266\345\274\271\345\207\272\351\241\265\357\274\214\350\264\237\350\264\243\345\261\225\347\244\272\345\275\223\345\211\215\350\257\206\345\210\253\347\232\204\351\223\266\350\241\214\347\253\231\347\202\271\343\200\201Google Drive \347\232\204\347\273\221\345\256\232\347\212\266\346\200\201\344\273\245\345\217\212\345\216\206\345\217\262\345\275\222\346\241\243\350\256\260\345\275\225\343\200\202\n- **Content Scripts (\345\206\205\345\256\271\350\204\232\346\234\254):** \345\234\250\345\205\267\344\275\223\347\232\204\351\223\266\350\241\214\350\264\246\345\215\225\351\241\265\351\235\242\357\274\210\345\246\202 Chase, BoA\357\274\211\350\277\220\350\241\214\343\200\202\350\264\237\350\264\243\346\213\246\346\210\252\344\270\213\350\275\275\343\200\201\350\257\273\345\217\226 DOM \346\225\260\346\215\256\345\271\266\350\275\254\346\215\242\346\240\274\345\274\217\343\200\202\n- **Background Worker (\345\220\216\345\217\260\346\234\215\345\212\241):** \345\244\204\347\220\206\345\244\215\346\235\202\347\232\204\345\220\216\345\217\260\344\273\273\345\212\241\357\274\214\346\257\224\345\246\202\351\200\232\350\277\207 `chrome.identity` \350\277\233\350\241\214 Google Drive OAuth \347\231\273\345\275\225\346\216\210\346\235\203\357\274\214\346\214\211\346\234\272\346\236\204\345\220\215\345\210\233\345\273\272\346\226\207\344\273\266\345\244\271\345\271\266\345\260\206 CSV \344\270\212\344\274\240\343\200\202\n\n### \360\237\216\250 \347\225\214\351\235\242\346\274\224\347\244\272\345\256\214\346\210\220\n\346\210\221\345\234\250\345\275\223\345\211\215 Web \345\272\224\347\224\250\344\270\255\346\220\255\345\273\272\344\272\206\346\211\251\345\261\225\347\250\213\345\272\217\347\232\204 1:1 \350\247\206\350\247\211 Mockup\357\274\210\351\273\230\350\256\244\345\260\272\345\257\270 `320px x 480px`\357\274\211\357\274\232\n- **\350\256\276\350\256\241\351\243\216\346\240\274**: \347\256\200\346\264\201\347\216\260\344\273\243\347\232\204\346\265\205\350\211\262\345\215\241\347\211\207\351\243\216\346\240\274\357\274\214\345\270\246\346\234\211\346\225\260\346\215\256\345\220\214\346\255\245\347\232\204\347\212\266\346\200\201\346\204\237\347\237\245\343\200\202\n- **\345\212\250\346\200\201\344\272\244\344\272\222**: \345\214\205\345\220\253\344\272\206\344\270\200\344\270\252\344\272\221\347\253\257\350\277\236\346\216\245\347\212\266\346\200\201\346\217\220\347\244\272\345\222\214\347\202\271\345\207\273\343\200\214\345\257\274\345\207\272\345\271\266\345\275\222\346\241\243\350\207\263\344\272\221\347\233\230\343\200\215\347\232\204\345\212\240\350\275\275\350\277\207\346\270\241\345\212\250\347\224\273\343\200\202\n\n\345\234\250\350\277\231\344\270\252\347\216\257\345\242\203\357\274\210AI Studio \347\275\221\351\241\265\351\242\204\350\247\210\357\274\211\344\270\255\346\227\240\346\263\225\347\233\264\346\216\245\350\277\220\350\241\214\345\271\266\346\211\223\345\214\205\347\234\237\346\255\243\347\232\204\346\265\217\350\247\210\345\231\250\346\217\222\344\273\266\357\274\210`.crx` \346\210\226 `manifest.json` \345\212\240\350\275\275\357\274\211\357\274\214\344\275\206\346\210\221\345\217\257\344\273\245\344\275\277\347\224\250 React \345\270\256\344\275\240\346\212\212\347\234\237\346\255\243\347\232\204 **\346\217\222\344\273\266\345\211\215\345\217\260 (UI) \344\270\216\344\270\232\345\212\241\351\200\273\350\276\221\350\204\232\346\211\213\346\236\266** \345\256\214\346\225\264\346\220\255\345\273\272\345\207\272\346\235\245\343\200\202\345\246\202\346\236\234\344\275\240\345\207\206\345\244\207\345\245\275\350\277\233\350\241\214\344\270\213\344\270\200\346\255\245\357\274\214\346\210\221\344\273\254\345\217\257\344\273\245\345\274\200\345\247\213\347\224\250 Vite + CRXJS \346\220\255\345\273\272\345\256\236\351\231\205\347\232\204\346\211\251\345\261\225\346\272\220\347\240\201\357\274\201"
