    replacement_infos {
      original_chunk {
        target_content: "  const handleSync = async () => {\n    setIsSyncing(true);\n    setError(null);\n    setSynced(false);\n\n    if (isExtension) {\n      try {\n        const tabs = await chrome.tabs.query({ active: true, currentWindow: true });\n        const activeTab = tabs[0];\n        \n        if (!activeTab?.id) throw new Error(\'No active tab found.\');\n\n        chrome.tabs.sendMessage(activeTab.id, { action: \'EXTRACT_STATEMENT\', payload: { includeStatementSuffix: includeSuffix } }, (extractResponse) => {\n          if (chrome.runtime.lastError) {\n            setError(\'\350\257\267\345\234\250\346\224\257\346\214\201\347\232\204\350\264\246\345\215\225\351\241\265\351\235\242\350\277\220\350\241\214 (Amex JP)\343\200\202\');\n            setIsSyncing(false);\n            return;\n          }\n          if (!extractResponse?.success) {\n            setError(extractResponse?.error || \'\346\217\220\345\217\226\346\225\260\346\215\256\345\244\261\350\264\245\');\n            setIsSyncing(false);\n            return;\n          }\n\n          chrome.runtime.sendMessage({\n            action: \'UPLOAD_TO_DRIVE\',\n            payload: { filename: extractResponse.filename, csvData: extractResponse.data, folderName: extractResponse.folderName || \'Exports\' }\n          }, (uploadResponse: any) => {\n            setIsSyncing(false);\n            if (uploadResponse?.success) {\n              setSynced(true);\n              setTimeout(() => setSynced(false), 3000);\n            } else {\n              setError(uploadResponse?.error || \'\344\270\212\344\274\240\345\244\261\350\264\245\');\n            }\n          });\n        });\n      } catch (err: any) {\n        setError(err.message || \'\345\217\221\347\224\237\346\234\252\347\237\245\351\224\231\350\257\257\');\n        setIsSyncing(false);\n      }\n    } else {\n      // \351\242\204\350\247\210\347\216\257\345\242\203 Mock \351\200\273\350\276\221\n      setTimeout(() => {\n        setIsSyncing(false);\n        setSynced(true);\n        setTimeout(() => setSynced(false), 3000);\n      }, 1500);\n    }\n  };"
        replacement_content: "  const handleSync = async () => {\n    setIsSyncing(true);\n    setToast(null);\n    setSynced(false);\n\n    if (isExtension) {\n      try {\n        const tabs = await chrome.tabs.query({ active: true, currentWindow: true });\n        const activeTab = tabs[0];\n        \n        if (!activeTab?.id) throw new Error(\'No active tab found.\');\n\n        chrome.tabs.sendMessage(activeTab.id, { action: \'EXTRACT_STATEMENT\', payload: { includeStatementSuffix: includeSuffix } }, (extractResponse) => {\n          if (chrome.runtime.lastError) {\n            showToast(\'\350\257\267\345\234\250\346\224\257\346\214\201\347\232\204\350\264\246\345\215\225\351\241\265\351\235\242\350\277\220\350\241\214 (Amex JP)\343\200\202\', \'error\');\n            setIsSyncing(false);\n            return;\n          }\n          if (!extractResponse?.success) {\n            showToast(extractResponse?.error || \'\346\217\220\345\217\226\346\225\260\346\215\256\345\244\261\350\264\245\', \'error\');\n            setIsSyncing(false);\n            return;\n          }\n\n          chrome.runtime.sendMessage({\n            action: \'UPLOAD_TO_DRIVE\',\n            payload: { filename: extractResponse.filename, csvData: extractResponse.data, folderName: extractResponse.folderName || \'Exports\' }\n          }, (uploadResponse: any) => {\n            setIsSyncing(false);\n            if (uploadResponse?.success) {\n              setSynced(true);\n              showToast(\'\345\267\262\346\210\220\345\212\237\344\277\235\345\255\230\350\207\263 Google Drive\', \'success\');\n              setTimeout(() => setSynced(false), 3000);\n            } else {\n              showToast(uploadResponse?.error || \'\344\270\212\344\274\240\345\244\261\350\264\245\', \'error\');\n            }\n          });\n        });\n      } catch (err: any) {\n        showToast(err.message || \'\345\217\221\347\224\237\346\234\252\347\237\245\351\224\231\350\257\257\', \'error\');\n        setIsSyncing(false);\n      }\n    } else {\n      // \351\242\204\350\247\210\347\216\257\345\242\203 Mock \351\200\273\350\276\221\n      setTimeout(() => {\n        setIsSyncing(false);\n        setSynced(true);\n        showToast(\'\345\267\262\346\210\220\345\212\237\344\277\235\345\255\230\350\207\263 Google Drive\', \'success\');\n        setTimeout(() => setSynced(false), 3000);\n      }, 1500);\n    }\n  };"
