\274\214\345\271\266\345\260\206\345\205\266\350\275\254\346\215\242\344\270\272\346\240\207\345\207\206\345\214\226 CSV \347\273\223\346\236\204\357\274\214\345\206\205\347\275\256\345\256\211\345\205\250\345\233\236\351\200\200\346\234\272\345\210\266\343\200\202\n*   **Drive \345\275\222\346\241\243\344\270\255\346\236\242 (`background.ts`)**\357\274\232\345\256\236\347\216\260\344\272\206 Service Worker \345\220\216\345\217\260\350\204\232\346\234\254\357\274\214\346\216\245\347\256\241\344\270\216 Google Drive REST API v3 \347\232\204\345\256\211\345\205\250\351\200\232\344\277\241\357\274\214\345\244\204\347\220\206\346\227\240\346\204\237 OAuth2 \345\207\255\350\257\201\345\210\267\346\226\260\345\222\214\345\244\232\351\203\250\345\210\206 (Multipart) \346\226\207\344\273\266\344\270\212\344\274\240\343\200\202\n*   **Popup UI \345\212\250\346\200\201\345\217\214\350\275\250\346\250\241\345\274\217**\357\274\232\346\233\264\346\226\260\344\272\206 `ExtensionPopupMockup` \347\273\204\344\273\266\343\200\202\346\243\200\346\265\213\345\210\260\345\216\237\347\224\237 Chrome \346\211\251\345\261\225\347\216\257\345\242\203\346\227\266\357\274\214\344\274\232\347\234\237\345\256\236\350\247\246\345\217\221\345\272\225\345\261\202 `chrome.tabs.sendMessage` \344\270\216\345\220\216\345\217\260\344\272\244\344\272\222\357\274\233\350\200\214\345\234\250\345\275\223\345\211\215 AI Studio \347\275\221\351\241\265\351\242\204\350\247\210\347\216\257\345\242\203\344\270\255\357\274\214\345\210\231\350\207\252\345\212\250\345\220\257\347\224\250\344\274\230\351\233\205\347\232\204\346\250\241\346\213\237\345\217\215\351\246\210\347\212\266\346\200\201\357\274\214\347\241\256\344\277\235\347\225\214\351\235\242\345\271\263\346\273\221\345\261\225\347\244\272\343\200\202\n\n**\345\246\202\344\275\225\346\265\213\350\257\225\347\234\237\345\256\236\346\217\222\344\273\266\345\212\237\350\203\275\357\274\232**\n1.  \346\202\250\345\217\257\344\273\245\347\202\271\345\207\27